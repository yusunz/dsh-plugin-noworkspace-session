{
  "name": "dsh-plugin-noworkspace-session",
  "version": "0.1.0",
  "description": "在新会话的工作区菜单里增加「不在工作区中工作」入口，创建未分组会话；并在通用设置中提供仿 Codex 的「无项目任务文件夹」默认位置（更改/重置，持久化到 profile 配置）。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
